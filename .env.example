# Database
POSTGRES_USER=lab-edu
POSTGRES_PASSWORD=
POSTGRES_DB=lab-edu
POSTGRES_PORT=5432

# Services
ENTRY_PORT=3000

# Images
CORE_IMAGE=ghcr.io/lab-edu/lab-edu-core:latest
WEB_IMAGE=ghcr.io/lab-edu/lab-edu-web:latest

# Browser-facing endpoints
NEXT_PUBLIC_API_BASE_URL=http://core.lab-edu.team/api/v1
NEXT_PUBLIC_CORE_DOCS_URL=http://core.lab-edu.team/swagger-ui.html

# CORS: allow web origin to call core with credentials
LAB_ALLOWED_ORIGINS=http://lab-edu.team,http://localhost:3000,http://127.0.0.1:3000

# Auth cookie settings for cross-subdomain login state
LAB_SECURITY_JWT_COOKIE_DOMAIN=.lab-edu.team
LAB_SECURITY_JWT_COOKIE_SECURE=false
LAB_SECURITY_JWT_COOKIE_SAME_SITE=Lax
