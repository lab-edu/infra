# Database
POSTGRES_USER=lab-edu
POSTGRES_PASSWORD=
POSTGRES_DB=lab-edu
POSTGRES_PORT=5432

# Images
CORE_IMAGE=ghcr.io/lab-edu/lab-edu-core:latest
WEB_IMAGE=ghcr.io/lab-edu/lab-edu-web:latest

# Web config
NEXT_PUBLIC_CORE_BASE_URL=http://localhost:8080
NEXT_IMAGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# CORS
LAB_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File upload limits (Spring Boot)
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=102MB

# AI grading (OpenAI)
LAB_AI_OPENAI_BASE_URL=https://api.openai.com/v1
LAB_AI_OPENAI_API_KEY=
LAB_AI_OPENAI_MODEL=gpt-4.1-mini
LAB_AI_OPENAI_TIMEOUT_SECONDS=40
